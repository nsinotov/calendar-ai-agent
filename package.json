{
  "name": "calendar-ai-agent",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" \"src/**/*.test.ts\"",
    "add-user": "tsx --env-file=.env src/scripts/add-user.ts",
    "set-balance": "tsx --env-file=.env src/scripts/set-balance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "gaxios": "^7.3.1",
    "googleapis": "^181.0.0",
    "grammy": "^1.46.0",
    "openai": "^7.20.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
