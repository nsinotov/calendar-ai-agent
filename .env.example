# --- Anthropic ---
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Your current prepaid balance in USD (optional). Spend is tracked locally.
ANTHROPIC_BUDGET_USD=20
# Warn when tracked balance drops below this
ANTHROPIC_LOW_BALANCE_USD=2

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token
# The only Telegram user ID the bot responds to
TELEGRAM_ALLOWED_USER_ID=123456789
# Production: public HTTPS URL of the webhook. Empty = long polling (local dev)
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram
# Random string (16+ chars) Telegram sends back to prove the request is genuine
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
PORT=3000

# --- Google Calendar (OAuth) ---
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary

# --- Behaviour ---
# Conversation language (ISO code): uk, en, ...
LANGUAGE=uk
TIMEZONE=Europe/Kyiv
# Conversation history is kept for this many days
CONTEXT_RETENTION_DAYS=7
# First day of the week: monday or sunday
WEEK_START=monday

# --- Reminders (times are HH:MM in TIMEZONE) ---
# Week summary, sent on the first day of the week
WEEKLY_REMINDER_ENABLED=true
WEEKLY_REMINDER_TIME=08:00
# Today's events summary, sent every day
DAILY_REMINDER_ENABLED=true
DAILY_REMINDER_TIME=08:00
# Reminder before each timed event
EVENT_REMINDER_ENABLED=true
EVENT_REMINDER_MINUTES_BEFORE=60
# How often the calendar is checked for upcoming events
CALENDAR_POLL_MINUTES=15

# --- Old events ---
# keep: leave them in the calendar; delete: remove events older than the retention period
OLD_EVENTS_ACTION=keep
OLD_EVENTS_RETENTION_DAYS=30

# --- Storage ---
# SQLite file location (context + notes). Mounted as a Docker volume.
DATA_DIR=./data

