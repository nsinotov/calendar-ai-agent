# --- LLM (shared across all users, paid by the admin) ---
# Defaults offered to new users by `pnpm add-user`; each user can pick their own after.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.1
LLM_MAX_TOKENS=8000
# low | medium | high | xhigh | max (empty = provider default)
LLM_EFFORT=medium
# Max tool-call rounds for one user message
LLM_MAX_TOOL_ITERATIONS=8
# Your current prepaid balance in USD (optional). Spend is tracked locally.
LLM_BUDGET_USD=20
# Warn when tracked balance drops below this
LLM_LOW_BALANCE_USD=2
# Model prices, USD per 1M tokens (see your provider's pricing page).
# Required when LLM_BUDGET_USD is set.
LLM_INPUT_PRICE_PER_MTOK=2
LLM_OUTPUT_PRICE_PER_MTOK=10
# Key for the chosen provider (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token
# Production: public HTTPS URL of the webhook. Empty = long polling (local dev)
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram
# Random string (16+ chars) Telegram sends back to prove the request is genuine
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
PORT=3000

# --- Google Calendar (OAuth) ---
# The app's own OAuth identity, shared across users. Each user authorizes it
# separately and gets their own refresh token, registered via `pnpm add-user`.
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# How often the scheduler checks every user's calendar for upcoming events
CALENDAR_POLL_MINUTES=15

# --- Secrets ---
# AES-256-GCM key for per-user secrets (Google refresh tokens, ...).
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Logging ---
# Verbose logs (raw request/response content). May contain personal data.
DEBUG_ENABLED=false
# Any combination of: error,warn,info
LOG_LEVELS=error,warn,info
# Any combination of: console,file
LOG_PROVIDERS=console
LOG_RETENTION_DAYS=14
# Directory the file provider writes into. Defaults to DATA_DIR/logs
LOG_DIR=./data/logs

# --- Storage ---
# SQLite file location (users, conversations, notes, secrets). Mounted as a Docker volume.
DATA_DIR=./data

