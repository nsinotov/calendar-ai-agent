# --- LLM (shared across all users, paid by the admin) ---
# Provider identifier: anthropic | openai (or any provider added to the LLM factory)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.1
LLM_MAX_TOKENS=8000
# low | medium | high | xhigh | max (empty = provider default)
LLM_EFFORT=medium
# Max tool-call rounds for one user message
LLM_MAX_TOOL_ITERATIONS=8
# Your current prepaid balance in USD (optional). Seeds the tracked balance on first start; spend is tracked
# locally. After a top-up run `pnpm set-balance <usd>` (this value is not read again).
LLM_BUDGET_USD=20
# Warn when tracked balance drops below this
LLM_LOW_BALANCE_USD=2
# Model prices, USD per 1M tokens (see your provider's pricing page).
# Required when LLM_BUDGET_USD is set.
LLM_INPUT_PRICE_PER_MTOK=2
LLM_OUTPUT_PRICE_PER_MTOK=10
# Extra topics the assistant may help with beyond calendar and notes (comma-separated, empty = none)
ALLOWED_TOPICS=
# Experimental: activity memory + suggestions tool (extra LLM calls, stores a short activity summary per user).
# Spends LLM tokens once a day per user even with no message sent (background activity-memory refresh).
SUGGESTIONS_ENABLED=false
# API key of the chosen provider
LLM_API_KEY=your-api-key-here

# --- Messaging ---
# Provider identifier: telegram (or any provider added to the messaging factory)
MESSAGING_PROVIDER=telegram
# Telegram settings
TELEGRAM_BOT_TOKEN=your-bot-token
# Production: public HTTPS URL of the webhook (https://<DOMAIN>/telegram). Empty = long polling (local dev)
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram
# Random string (16+ chars) Telegram sends back to prove the request is genuine
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
PORT=3000
# Docker webhook mode only: the domain Caddy gets a TLS certificate for (must point at the server)
DOMAIN=bot.example.com
# Docker webhook mode only: contact email shown in the privacy policy at https://<DOMAIN>/privacy
PRIVACY_CONTACT_EMAIL=you@example.com

# --- Calendar: Google (OAuth) ---
# The app's own OAuth identity, shared across users. Each user authorizes it
# separately and gets their own refresh token, registered via `pnpm add-user`.
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# How often the scheduler checks every user's calendar for upcoming events
CALENDAR_POLL_MINUTES=15

# --- Secrets ---
# AES-256-GCM key for per-user secrets (Google refresh tokens, ...).
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Logging ---
# Verbose logs (raw request/response content). May contain personal data.
DEBUG_ENABLED=false
# Any combination of: error,warn,info
LOG_LEVELS=error,warn,info
# Comma-separated provider identifiers: console, file
LOG_PROVIDERS=console
# Message admins about error-level events (event name and kind only; repeats deduplicated)
ADMIN_ERROR_ALERTS=true
LOG_RETENTION_DAYS=14
# Directory the file provider writes into. Defaults to DATA_DIR/logs
LOG_DIR=./data/logs

# --- Storage ---
# Provider identifier: sqlite (or any provider added to the storage factory)
STORAGE_PROVIDER=sqlite
# SQLite file location (users, conversations, notes, secrets). Mounted as a Docker volume.
DATA_DIR=./data
# Default for a new user's conversation-history retention (days); changeable per user afterwards.
CONTEXT_RETENTION_DAYS=7
# How long a tool result (e.g. calendar data) stays fresh in the conversation history before it's
# redacted from context; the surrounding chat text is unaffected. Keeps token cost down since raw
# tool results (list_events dumps, etc.) are usually the bulk of a conversation's size.
TOOL_RESULT_RETENTION_MINUTES=60

